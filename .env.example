# Copy this file to .env in the XDep project root and replace the example values.
# Each prefix (EXAMPLE1, EXAMPLE2, etc.) becomes a connection name in the app.

EXAMPLE1_HOST='example.server.com'
EXAMPLE1_USER='example'
EXAMPLE1_PASSWORD='replace-with-your-password'
EXAMPLE1_DIRECTORY='/public_html/example1'
# Optional SFTP port; defaults to 22.
EXAMPLE1_PORT=22

# Optional backups: this is a directory ON THE SFTP SERVER, not localy.
# It must be separate from, and not nested within, EXAMPLE1_DIRECTORY.
EXAMPLE1_BACKUP_DIRECTORY='/private-backups/...'

# Before overwriting an existing file, XDep copies its old contents to:
# <backup-directory>/<connection-and-target-id>/<unique-upload-id>/<relative-path>
# Missing backup directories are created. If a backup fails, that file is not replaced.
# New remote files do not need backups. Backups are retained until you remove them.
# Omit BACKUP_DIRECTORY or leave it empty to overwrite WITHOUT backups.

EXAMPLE2_HOST='example.server.com'
EXAMPLE2_USER='example'
EXAMPLE2_PASSWORD='replace-with-your-password'
EXAMPLE2_DIRECTORY='/public_html/example2'
# Backups disabled for this connection:
EXAMPLE2_BACKUP_DIRECTORY=''